---
const year = new Date().getFullYear();
---

<footer class="overflow-hidden bg-bg pt-8 pb-12">
  <p
    aria-label="tyrel."
    class="text-center font-head text-[33vw] leading-none font-extrabold tracking-[-0.05em] text-ink select-none"
  >tyrel<span class="text-glow">.</span></p>
  <div class="mx-auto mt-16 flex max-w-[1440px] flex-col items-center justify-between gap-2 px-4 sm:flex-row sm:px-8 lg:px-20">
    <p class="font-cap text-sm text-ink-3">&copy; {year} Tyrel Chambers</p>
    <p class="font-mono text-sm text-ink-3">tyrelchambers.com</p>
  </div>
</footer>
