---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import WhatIDo from "../components/WhatIDo.astro";
import SectionHeader from "../components/SectionHeader.astro";
import CaseCard from "../components/CaseCard.astro";
import LessonCard from "../components/LessonCard.astro";
import Writing from "../components/Writing.astro";
import Contact from "../components/Contact.astro";
import { clients, roles } from "../data/content";
import { domainOf, getProjects } from "../data/projects";

const products = getProjects({ kind: "product" });
const lessons = getProjects({ kind: "lesson" });
const container = "mx-auto max-w-[1440px] px-4 sm:px-8 lg:px-20";
---

<Layout>
  <Hero />
  <WhatIDo />

  <section id="client-work" class="bg-bg">
    <div class:list={[container, "flex flex-col gap-10 pt-20 pb-6 lg:pt-24"]}>
      <SectionHeader
        title="Client work"
        subtitle="I take on client projects alongside my own work. Here's who I've worked with and what I built for them."
      />
      <div class="flex flex-col gap-6">
        {clients.map((c) => (
          <CaseCard
            label={c.category}
            labelStyle="category"
            meta={c.where}
            title={c.name}
            summary={c.summary}
            points={c.points}
            tags={c.tags}
            image={c.image}
            imageAlt={`The ${c.name} website homepage`}
          />
        ))}
      </div>
    </div>
  </section>

  <section id="projects" class="bg-bg">
    <div class:list={[container, "flex flex-col gap-6 pt-16 pb-20 lg:pb-[120px]"]}>
      <div class="pb-8">
        <SectionHeader
          title="Projects"
          subtitle="I designed, built and run each of these myself. They range from a Kubernetes admin tool to a searchable database of government records."
        />
      </div>
      {products.map((p, i) => (
        <CaseCard
          label={String(i + 1).padStart(2, "0")}
          labelStyle="index"
          meta={domainOf(p.url)}
          title={p.title}
          summary={p.description}
          tags={p.stack}
          cta={{ label: `Visit ${domainOf(p.url)}`, href: p.url }}
          image={p.image}
          imageAlt={`Screenshot of ${p.title}`}
          flip={i % 2 === 1}
        />
      ))}

      <div class="flex flex-col gap-7 pt-10">
        <SectionHeader
          level="heading"
          title="The teaching series"
          subtitle="I built a set of interactive lessons on the computer science topics that come up in technical interviews. In each one you run the code yourself and watch what it does."
        />
        <div class="grid gap-4 md:grid-cols-3">
          {lessons.map((l) => <LessonCard project={l} />)}
        </div>
      </div>
    </div>
  </section>

  <Writing />

  <section id="about" class="bg-bg">
    <div class:list={[container, "flex flex-col pt-20 pb-10 lg:pt-[120px]"]}>
      <div class="flex max-w-[765px] flex-col gap-6">
        <p class="eyebrow text-[13px] tracking-[0.12em] text-accent">About</p>
        <h2 class="section-heading text-ink">Delivering value with a wide and diverse skill set.</h2>
      </div>
      <p class="pt-10 text-lg leading-[1.6] text-ink-2 md:text-xl">
        I am a man of many hats. I enjoy everything from designing good‑looking web applications to developing them at the same time. I appreciate the art of photography—capturing the night sky, the northern lights, solar eclipses, and even modest subjects like plants and leaves on my hikes. All of these experiences give me a deep appreciation for the world, its landscapes, and the beauty found in something well made.
      </p>
    </div>
  </section>

  <section id="experience" class="bg-bg">
    <div class:list={[container, "flex flex-col gap-14 pt-20 pb-20 lg:pb-[120px]"]}>
      <SectionHeader title="Experience" subtitle="I've been a professional software engineer since 2021." />
      <ol class="divide-y divide-line">
        {roles.map((r) => (
          <li class="flex flex-col gap-4 py-10 md:flex-row md:gap-12">
            <div class="flex flex-col gap-1.5 md:w-60 md:shrink-0">
              <p class="font-mono text-[15px] font-medium text-accent">{r.dates}</p>
              <p class="font-mono text-[13px] text-ink-3">{r.duration}</p>
            </div>
            <div class="flex flex-col gap-3.5">
              <h3 class="flex flex-wrap items-baseline gap-x-2.5">
                <span class="font-head text-[26px] font-semibold tracking-[-0.02em] text-ink">{r.role}</span>
                <span class="text-xl text-ink-2">@ {r.company}</span>
              </h3>
              <p class="max-w-[760px] text-[17px] leading-[1.6] text-ink-2">{r.description}</p>
              <p class="pt-1 font-mono text-[13px] text-ink-2">{r.stack}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Contact />
</Layout>
